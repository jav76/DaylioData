# DaylioData Solution EditorConfig & Code Style Rules
root = true

# ==============================================================================
# Global Formatting Settings
# ==============================================================================
[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = false
end_of_line = lf
max_line_length = 120

# Markdown files (Preserve intentional trailing whitespace)
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# XML / Project / Build configuration files
[*.{xml,props,targets,csproj,sln}]
indent_size = 2

# JSON / YAML configuration files
[*.{json,yml,yaml}]
indent_size = 2

# ==============================================================================
# C# Source Files (.cs)
# ==============================================================================
[*.cs]

# ------------------------------------------------------------------------------
# Severities & General Diagnostics
# ------------------------------------------------------------------------------
dotnet_analyzer_diagnostic.severity = suggestion

# ------------------------------------------------------------------------------
# Namespace & Usings Organization
# ------------------------------------------------------------------------------
# Enforce modern file-scoped namespaces (namespace DaylioData;)
csharp_style_namespace_declarations = file_scoped:suggestion

# Usings outside namespace, sorted with System first
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_style_prefer_simplified_interpolation = true:suggestion

# ------------------------------------------------------------------------------
# Variables & Type Declaration Rules
# ------------------------------------------------------------------------------
# Disallow 'var' - prefer explicit type declarations
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion

# Target-typed 'new()' allowed when explicit type is declared on the left
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion
csharp_style_prefer_tuple_swap = true:suggestion

# ------------------------------------------------------------------------------
# Indentation, Braces & Whitespace (Allman Style)
# ------------------------------------------------------------------------------
csharp_indent_braces = false
csharp_indent_switch_labels = true
csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = true

# Allman bracing - open brace on its own line
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true

# Spacing rules
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_around_binary_operators = before_and_after

# ------------------------------------------------------------------------------
# Expression-Bodied Members vs Block Bodies
# ------------------------------------------------------------------------------
# Use expression bodies (=>) for single-line members; require block bodies for multi-line
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_style_expression_bodied_accessors = when_on_single_line:suggestion
csharp_style_expression_bodied_operators = when_on_single_line:suggestion
csharp_style_expression_bodied_indexers = when_on_single_line:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion
csharp_style_expression_bodied_local_functions = when_on_single_line:suggestion

# Require block bodies with braces for constructors
csharp_style_expression_bodied_constructors = false:suggestion

# ------------------------------------------------------------------------------
# Modern Pattern Matching & Null Checking
# ------------------------------------------------------------------------------
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_null_check_over_type_check = true:suggestion
csharp_style_prefer_extended_property_pattern = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion
csharp_style_prefer_index_operator = true:suggestion
csharp_style_prefer_range_operator = true:suggestion

dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion

# ------------------------------------------------------------------------------
# Member Qualification & Accessibility Modifiers
# ------------------------------------------------------------------------------
# Do not use 'this.' qualifiers
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Require explicit accessibility modifiers
dotnet_style_require_accessibility_modifiers = always:suggestion

# Prefer readonly fields for immutable data
dotnet_style_readonly_field = true:suggestion
dotnet_style_readonly_field_body = true:suggestion

# ------------------------------------------------------------------------------
# Naming Conventions
# ------------------------------------------------------------------------------
# Private and internal instance fields: _camelCase
dotnet_naming_rule.private_internal_fields_should_be_camel_case.symbols = private_internal_fields
dotnet_naming_rule.private_internal_fields_should_be_camel_case.style = prefix_underscore_camel_case
dotnet_naming_rule.private_internal_fields_should_be_camel_case.severity = suggestion

dotnet_naming_symbols.private_internal_fields.applicable_kinds = field
dotnet_naming_symbols.private_internal_fields.applicable_accessibilities = private, internal, protected_and_internal
dotnet_naming_style.prefix_underscore_camel_case.capitalization = camel_case
dotnet_naming_style.prefix_underscore_camel_case.required_prefix = _

# Static private fields: _camelCase or s_camelCase
dotnet_naming_rule.private_static_fields_should_be_camel_case.symbols = private_static_fields
dotnet_naming_rule.private_static_fields_should_be_camel_case.style = prefix_underscore_or_s_camel_case
dotnet_naming_rule.private_static_fields_should_be_camel_case.severity = suggestion

dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private, internal
dotnet_naming_symbols.private_static_fields.required_modifiers = static
dotnet_naming_style.prefix_underscore_or_s_camel_case.capitalization = camel_case
dotnet_naming_style.prefix_underscore_or_s_camel_case.required_prefix = _

# Constants: CAPS_CASE
dotnet_naming_rule.constants_should_be_caps_case.symbols = constant_fields
dotnet_naming_rule.constants_should_be_caps_case.style = caps_case_style
dotnet_naming_rule.constants_should_be_caps_case.severity = suggestion

dotnet_naming_symbols.constant_fields.applicable_kinds = field, local
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_style.caps_case_style.capitalization = all_upper
dotnet_naming_style.caps_case_style.word_separator = _

# Interfaces: IPascalCase
dotnet_naming_rule.interfaces_should_start_with_i.symbols = interface_types
dotnet_naming_rule.interfaces_should_start_with_i.style = i_prefix_style
dotnet_naming_rule.interfaces_should_start_with_i.severity = suggestion

dotnet_naming_symbols.interface_types.applicable_kinds = interface
dotnet_naming_style.i_prefix_style.capitalization = pascal_case
dotnet_naming_style.i_prefix_style.required_prefix = I

# Type parameters: TPascalCase
dotnet_naming_rule.type_parameters_should_start_with_t.symbols = type_parameters
dotnet_naming_rule.type_parameters_should_start_with_t.style = t_prefix_style
dotnet_naming_rule.type_parameters_should_start_with_t.severity = suggestion

dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_style.t_prefix_style.capitalization = pascal_case
dotnet_naming_style.t_prefix_style.required_prefix = T

# Public and protected members / types: PascalCase
dotnet_naming_rule.public_members_should_be_pascal_case.symbols = public_members
dotnet_naming_rule.public_members_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.public_members_should_be_pascal_case.severity = suggestion

dotnet_naming_symbols.public_members.applicable_kinds = class, struct, enum, property, method, event, delegate
dotnet_naming_symbols.public_members.applicable_accessibilities = public, protected, protected_or_internal
